{
  "name": "default",
  "level_field": "level",
  "module_field": "source",
  "pattern": "[{level}][{pid}][{tid}][{timestamp}][{source}:{line}] {message}",
  "fields": {
    "level": { "type": "enum", "values": ["T", "D", "I", "W", "E", "F"] },
    "pid": { "type": "int" },
    "tid": { "type": "int" },
    "timestamp": { "type": "datetime", "format": "%m-%d %H:%M:%S.%f" },
    "source": { "type": "string" },
    "line": { "type": "int" },
    "message": { "type": "string", "greedy": true }
  }
}
